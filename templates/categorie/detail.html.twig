{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }}{% endblock %}

{% block body %}
<h1 class="mb-2">{{ categorie.nom }}</h1>
<p class="text-muted">{{ categorie.description ?? 'Pas de description.' }}</p>

<p>
    <span class="badge bg-secondary rounded-pill">{{ categorie.articles|length }} article(s)</span>
</p>

<h2 class="h4 mt-4">Articles de cette catégorie</h2>

{% if categorie.articles is empty %}
    <div class="alert alert-info">Aucun article dans cette catégorie.</div>
{% else %}
    <ul class="list-group mb-4">
        {% for article in categorie.articles %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="{{ path('app_article_detail', {id: article.id}) }}">{{ article.titre }}</a>
            <small class="text-muted">{{ article.auteur }}</small>
        </li>
        {% endfor %}
    </ul>
{% endif %}

<div class="d-flex gap-2 align-items-center">
    <a href="{{ path('app_article_nouveau', {categorie: categorie.id}) }}" class="btn btn-success">+ Créer un article ici</a>
    <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}" class="btn btn-primary">Modifier</a>

    <form method="post" action="{{ path('app_categorie_supprimer', {id: categorie.id}) }}"
          onsubmit="return confirm('Supprimer cette catégorie ?');" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_categorie_' ~ categorie.id) }}">
        <button type="submit" class="btn btn-danger">Supprimer</button>
    </form>

    <a href="{{ path('app_categories') }}" class="btn btn-outline-secondary">← Retour</a>
</div>
{% endblock %}