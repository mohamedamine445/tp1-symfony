{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Articles</h1>
    <a href="{{ path('app_article_nouveau') }}" class="btn btn-primary">+ Nouvel article</a>
</div>

{# Step 7: filter by category #}
<div class="mb-3">
    <a href="{{ path('app_articles') }}"
       class="btn btn-sm {{ not categorieActive ? 'btn-dark' : 'btn-outline-dark' }}">Toutes</a>
    {% for c in categories %}
        <a href="{{ path('app_articles', {categorie: c.id}) }}"
           class="btn btn-sm {{ categorieActive == c.id ? 'btn-dark' : 'btn-outline-dark' }}">{{ c.nom }}</a>
    {% endfor %}
</div>

{% if articles is empty %}
    <div class="alert alert-info">
        Aucun article{{ categorieActive ? ' dans cette catégorie' : '' }}.
        <a href="{{ path('app_article_nouveau') }}" class="alert-link">Créer un article</a>
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-bordered table-hover mt-3">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Catégorie</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                <tr>
                    <td class="text-center">{{ article.id }}</td>
                    <td><a href="{{ path('app_article_detail', {id: article.id}) }}">{{ article.titre }}</a></td>
                    <td>{{ article.auteur }}</td>
                    <td>{{ article.categorie ? article.categorie.nom : '-' }}</td>
                    <td>{{ article.dateCreation|date('d/m/Y') }}</td>
                    <td class="text-center">
                        {% if article.publie %}
                            <span class="badge bg-success">Publié</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">Brouillon</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <a href="{{ path('app_article_detail', {id: article.id}) }}" class="btn btn-outline-primary btn-sm">Voir</a>
                        <a href="{{ path('app_article_modifier', {id: article.id}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="mt-3 text-muted">{{ articles|length }} article(s)</p>
{% endif %}
{% endblock %}