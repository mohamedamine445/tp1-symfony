{% extends 'base.html.twig' %}

{% block title %}Mes tâches{% endblock %}

{% block body %}
<h1 class="mb-4">Mes tâches</h1>

<a href="{{ path('app_tache_ajouter') }}" class="btn btn-primary mb-3">+ Ajouter une tâche</a>

{% if taches is empty %}
    <div class="alert alert-info">Aucune tâche pour le moment.</div>
{% else %}
    <ul class="list-group">
        {% for tache in taches %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="{{ path('app_tache_detail', {id: tache.id}) }}"
               style="{{ tache.terminee ? 'text-decoration: line-through;' : '' }}">
                {{ tache.titre }}
            </a>
            {% if tache.terminee %}
                <span class="badge bg-secondary">Terminée</span>
            {% else %}
                <a href="{{ path('app_tache_terminer', {id: tache.id}) }}"
                   class="btn btn-sm btn-success">Terminer</a>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
    <p class="mt-3 text-muted">{{ taches|length }} tâche(s)</p>
{% endif %}
{% endblock %}